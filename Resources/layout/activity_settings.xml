<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="0dp">

        <!-- Lock Challenge Section -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_challenge" />

        <RadioGroup
            android:id="@+id/rg_challenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <RadioButton
                android:id="@+id/rb_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/challenge_time"
                android:padding="12dp" />

            <RadioButton
                android:id="@+id/rb_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/challenge_battery"
                android:padding="12dp" />

            <RadioButton
                android:id="@+id/rb_hour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/challenge_hour"
                android:padding="12dp" />

            <RadioButton
                android:id="@+id/rb_dailycode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/challenge_dailycode"
                android:padding="12dp" />

        </RadioGroup>

        <TextView
            android:id="@+id/tv_challenge_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:background="@color/button_bg"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_secondary"
            android:layout_marginTop="8dp" />

        <!-- Tolerance & Parameters Section -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_tolerance" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/time_tolerance"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/sp_time_tolerance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="150dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/battery_tolerance"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/sp_battery_tolerance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="150dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/grace_period"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/sp_grace_period"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="150dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_secondary"
            android:layout_marginTop="8dp" />

        <!-- Behavior Section -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_behavior" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/auto_start"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/sw_auto_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/auto_start" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/enable_haptics"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/sw_haptics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/enable_haptics" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/enable_kiosk"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/sw_kiosk_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/enable_kiosk" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/kiosk_info"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_secondary"
            android:layout_marginTop="8dp" />

        <!-- Appearance Section -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_appearance" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_mode"
            android:textSize="16sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp" />

        <RadioGroup
            android:id="@+id/rg_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rb_theme_dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_dark" />

            <RadioButton
                android:id="@+id/rb_theme_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_light" />

            <RadioButton
                android:id="@+id/rb_theme_system"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/theme_system" />

        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/high_contrast"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/sw_high_contrast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/high_contrast" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_secondary"
            android:layout_marginTop="8dp" />

        <!-- Security Section -->
        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_security" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/strict_mode"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/sw_strict_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/strict_mode" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/strict_mode_desc"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
