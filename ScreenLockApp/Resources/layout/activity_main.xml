<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/mainTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Tolerance Setting -->
        <TextView
            android:id="@+id/toleranceLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tolerance_label"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <RadioGroup
            android:id="@+id/toleranceGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/toleranceStrict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tolerance_strict" />

            <RadioButton
                android:id="@+id/toleranceNormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tolerance_normal"
                android:checked="true" />

            <RadioButton
                android:id="@+id/toleranceRelaxed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tolerance_relaxed" />
        </RadioGroup>

        <!-- Grace Period -->
        <TextView
            android:id="@+id/gracePeriodLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grace_period_label"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <CheckBox
            android:id="@+id/gracePeriodEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grace_period_enabled"
            android:checked="true" />

        <TextView
            android:id="@+id/gracePeriodDurationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/grace_period_duration_label"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/gracePeriodDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/grace_period_options" />

        <!-- Lock Task Mode -->
        <TextView
            android:id="@+id/lockTaskModeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_task_mode_label"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <CheckBox
            android:id="@+id/lockTaskModeEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/lock_task_mode_enabled" />

        <!-- Trigger Lock Button -->
        <Button
            android:id="@+id/triggerLockButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/trigger_lock_button"
            android:layout_marginTop="32dp"
            android:padding="16dp" />

    </LinearLayout>
</ScrollView>
