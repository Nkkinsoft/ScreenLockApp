<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.nkkinsoft.screenlockapp</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.2.0-alpha</ApplicationDisplayVersion>
    <ApplicationTitle>ScreenLockApp</ApplicationTitle>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);ScreenLockApp.Tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.0.4" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.1" />
    <PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.2.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Preference" Version="1.2.1.11" />
  </ItemGroup>

</Project>
